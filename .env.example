# ──────────────────────────────────────────────────────────────────
# TrueProfile AI – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# Development (SQLite, no setup required):
DATABASE_URL=sqlite:///./trueprofile.db

# Production (PostgreSQL – replace with your actual connection string):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Auth ──────────────────────────────────────────────────────────
# Set to true to skip API key checks during local development
BYPASS_AUTH=true
# Generate a key with: python scripts/generate_api_key.py --owner "your@email.com"

# ── Sentry (Error Monitoring) ─────────────────────────────────────
# Get your DSN from https://sentry.io — leave blank to disable
SENTRY_DSN=

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for open access (dev only).
ALLOWED_ORIGINS=*

# ── Social Media API Keys (add as needed) ─────────────────────────
# INSTAGRAM_API_KEY=
# TWITTER_BEARER_TOKEN=
