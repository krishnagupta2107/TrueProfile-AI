# ──────────────────────────────────────────────────────────────────
# TrueProfile AI – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# Development (SQLite, no setup required):
DATABASE_URL=sqlite:///./trueprofile.db

# Production (PostgreSQL – replace with your actual connection string):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── API Keys (add as needed) ──────────────────────────────────────
# INSTAGRAM_API_KEY=
# TWITTER_BEARER_TOKEN=
